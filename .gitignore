# =====================================================================
# EcoTrace Repository .gitignore
# =====================================================================

# Environment Variables & Secrets (NEVER commit secrets to GitHub)
.env
.env.*
!.env.example
*.pem
*.key
*.cert
secrets.json

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Outputs & Caches
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Python Artifacts & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
develop-eggs/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
ecotrace.db
*.sqlite3

# Test Coverage & Benchmarks
coverage/
.nyc_output/
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# IDE, Editor & OS Specific Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Deployment, Vercel & Cloud metadata
.vercel
.serverless/
.terraform/
*.tfstate
*.tfstate.*

# AI & Local Scratchpad Artifacts
.gemini/
.system_generated/
*.log

# Personal Notes & Private Demo Materials
docs/demo-script.md
*demo-script*
*pitch*
*presentation-notes*

