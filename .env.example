# EcoTrace Environment Configuration

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAPLIBRE_STYLE=https://demotiles.maplibre.org/style.json

# Backend (FastAPI)
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL / Supabase - optional local SQLite fallback available)
DATABASE_URL=sqlite:///./ecotrace.db

# LLM API (for supply-chain reasoning & recommendations)
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
